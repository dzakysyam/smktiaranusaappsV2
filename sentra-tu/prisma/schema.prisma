generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model OutgoingLetter {
  id String @id @default(uuid())
  subject String
  recipient String
  authorId String
  status String @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events LetterEvent[]
}
model LetterEvent {
  id String @id @default(uuid())
  letterId String
  letter OutgoingLetter @relation(fields: [letterId], references: [id])
  action String
  actorId String
  createdAt DateTime @default(now())
  @@index([letterId, createdAt])
}
model TuReport {
  id String @id @default(uuid())
  authorId String
  version Int @default(1)
  status String @default("DRAFT")
  syncStatus String @default("LOCAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions ReportVersion[]
}
model ReportVersion {
  id String @id @default(uuid())
  reportId String
  report TuReport @relation(fields: [reportId], references: [id])
  number Int
  status String
  summary Json
  feedback String?
  reviewerId String?
  createdAt DateTime @default(now())
  @@unique([reportId, number])
}
model IntegrationEvent {
  id String @id
  reportId String
  version Int
  action String
  payload Json
  status String @default("PENDING")
  attempts Int @default(0)
  createdAt DateTime @default(now())
  @@index([status])
}
model AppliedDecision {
  id String @id
  reportId String
  version Int
  action String
  feedback String
  actorId String
  createdAt DateTime @default(now())
}
